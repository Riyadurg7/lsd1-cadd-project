npts 98 94 48                        # num.grid points in xyz
gridfld proteinfinal.maps.fld        # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N NA OA SA     # receptor atom types
ligand_types A C F NA Cl OA N HD     # ligand atom types
receptor proteinfinal.pdbqt          # macromolecule
gridcenter -26.697 12.544 -5.829     # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map proteinfinal.A.map               # atom-specific affinity map
map proteinfinal.C.map               # atom-specific affinity map
map proteinfinal.F.map               # atom-specific affinity map
map proteinfinal.NA.map              # atom-specific affinity map
map proteinfinal.Cl.map              # atom-specific affinity map
map proteinfinal.OA.map              # atom-specific affinity map
map proteinfinal.N.map               # atom-specific affinity map
map proteinfinal.HD.map              # atom-specific affinity map
elecmap proteinfinal.e.map           # electrostatic potential map
dsolvmap proteinfinal.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
