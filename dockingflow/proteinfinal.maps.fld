# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by ./autogrid4.
#
#SPACING 0.375
#NELEMENTS 98 94 48
#CENTER -26.697 12.544 -5.829
#MACROMOLECULE proteinfinal.pdbqt
#GRID_PARAMETER_FILE ./dock.gpf
#
ndim=3			# number of dimensions in the field
dim1=99			# number of x-elements
dim2=95			# number of y-elements
dim3=49			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=10		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=proteinfinal.maps.xyz filetype=ascii offset=0
coord 2 file=proteinfinal.maps.xyz filetype=ascii offset=2
coord 3 file=proteinfinal.maps.xyz filetype=ascii offset=4
label=A-affinity	# component label for variable 1
label=C-affinity	# component label for variable 2
label=F-affinity	# component label for variable 3
label=NA-affinity	# component label for variable 4
label=Cl-affinity	# component label for variable 5
label=OA-affinity	# component label for variable 6
label=N-affinity	# component label for variable 7
label=HD-affinity	# component label for variable 8
label=Electrostatics	# component label for variable 8
label=Desolvation	# component label for variable 9
#
# location of affinity grid files and how to read them
#
variable 1 file=proteinfinal.A.map filetype=ascii skip=6
variable 2 file=proteinfinal.C.map filetype=ascii skip=6
variable 3 file=proteinfinal.F.map filetype=ascii skip=6
variable 4 file=proteinfinal.NA.map filetype=ascii skip=6
variable 5 file=proteinfinal.Cl.map filetype=ascii skip=6
variable 6 file=proteinfinal.OA.map filetype=ascii skip=6
variable 7 file=proteinfinal.N.map filetype=ascii skip=6
variable 8 file=proteinfinal.HD.map filetype=ascii skip=6
variable 9 file=proteinfinal.e.map filetype=ascii skip=6
variable 10 file=proteinfinal.d.map filetype=ascii skip=6
